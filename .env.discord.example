# Discord bot deployment environment
# Copy this file to .env, or run install-discord-bot-windows.cmd and fill prompts.

# Required Discord settings
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord runtime defaults
DISCORD_MODE=true
DISCORD_SHOW=false
DISCORD_DEFAULT_BRANCH=公館分館

# Library status/booking defaults
LIB_BASE=https://www.lib.ntnu.edu.tw
LIB_SERVICE_BASE=https://www.lib.ntnu.edu.tw/service
DEFAULT_BRANCH=公館分館
BRANCH_OPTIONS=總館,公館分館,林口分館
DEFAULT_ROOM_KEYWORD=401
DEFAULT_START=18:30
DEFAULT_END=20:30
DEFAULT_PEOPLE=4

# CAPTCHA / browser automation
AUTO_SOLVE_CAPTCHA=true
CAPTCHA_SOLVER_TIMEOUT=10000
PYTHON_CMD=.venv\Scripts\python.exe

# Optional: enable /cred-set, /cred-view, /cred-delete
# DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# CREDENTIALS_ENCRYPTION_KEY=

# Optional Hermes natural-language parser fallback
# Example when Hermes runs on the Docker host: http://host.docker.internal:8787/parse
HERMES_PARSE_URL=
HERMES_PARSE_TOKEN=
HERMES_PARSE_TIMEOUT_MS=8000
PARSER_FEEDBACK_ENABLED=true
PARSER_FEEDBACK_LOG_PATH=.local/natural-language-feedback.jsonl
