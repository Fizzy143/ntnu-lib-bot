PORT=3000

# Site roots
LIB_BASE=https://www.lib.ntnu.edu.tw
LIB_SERVICE_BASE=https://www.lib.ntnu.edu.tw/service

# Defaults
DEFAULT_BRANCH=公館分館
DEFAULT_ROOM_KEYWORD=401
DEFAULT_DATE=2026-05-23
DEFAULT_START=18:30
DEFAULT_END=20:30
DEFAULT_PEOPLE=4
BRANCH_OPTIONS=總館,公館分館,林口分館

# Booking credentials
# Prefer these names to avoid colliding with Windows USERNAME.
LIBRARY_USERNAME=
LIBRARY_PASSWORD=

# Backward-compatible names. Avoid USERNAME on Windows because it may already be set by the OS.
USERNAME=
PASSWORD=

# CAPTCHA
AUTO_SOLVE_CAPTCHA=true
CAPTCHA_SOLVER_TIMEOUT=10000
PYTHON_CMD=.venv\Scripts\python.exe

# Discord bot
DISCORD_MODE=true
DISCORD_SHOW=false
DISCORD_DEFAULT_BRANCH=公館分館
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
