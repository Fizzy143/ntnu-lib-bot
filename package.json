{
  "name": "ntnu-lib-bot",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "server": "node src/server/index.js",
    "discord": "node src/bot/discord_bot.js",
    "discord:validate": "node scripts/validate-discord-env.mjs",
    "discord:deploy:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-discord-windows.ps1",
    "discord:docker:build": "docker compose -f docker-compose.discord.yml build",
    "discord:docker:up": "docker compose -f docker-compose.discord.yml up -d",
    "discord:docker:logs": "docker compose -f docker-compose.discord.yml logs -f discord-bot",
    "discord:docker:down": "docker compose -f docker-compose.discord.yml down",
    "status": "node src/cli/status_cli.js",
    "book": "node src/cli/book_cli.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test": "echo \"No tests configured yet\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "discord.js": "^14.23.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.21.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
